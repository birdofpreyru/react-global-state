{
  "extends": "@tsconfig/recommended",
  "include": ["src", "types.d.ts"],
  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "build/types",
    "rootDir": "./src",
    "strict": true,
    "types": ["node"],
    "verbatimModuleSyntax": true,
  }
}