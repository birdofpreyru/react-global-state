{
  "extends": "@tsconfig/recommended",
  "include": ["src", "types.d.ts"],
  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": true,
    "jsx": "react-jsx",
    "isolatedModules": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noUncheckedIndexedAccess": true,
    "outDir": "build",
    "rootDir": "./src",
    "strict": true,
    "types": ["node"],
    "verbatimModuleSyntax": true,
  }
}