{
  "extends": "@tsconfig/recommended",

  // TODO: This actually breaks VSCode code analysis inside ts-types. We should
  // do no exclusion here, but provide a different TS config file for Jest tests
  // to use.
  "exclude": ["__tests__/ts-types"],

  "compilerOptions": {
    // NOTE: These are only necessary to support a few asset imports inside
    // Jest tests... all stems from the problem that while TypeScript does
    // resolve .js imports to the .ts files at the same path, Jest does not
    // do it, so we need correct paths in the tests (at least for now).
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,

    "declaration": true,
    "jsx": "react-jsx",
    "isolatedModules": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noUncheckedIndexedAccess": true,
    "outDir": "build",
    "paths": {
      "*": ["./*"]
    },
    "rootDir": ".",
    "types": ["node"],
    "verbatimModuleSyntax": true
  }
}
